---
import Card from './Card.astro';
interface Item { title: string; desc?: string; href?: string; tag?: string }
interface Props { items: Item[]; columns?: 2 | 3 }
const { items, columns = 3 } = Astro.props;
const colClass = columns === 2 ? 'sm:grid-cols-2' : 'sm:grid-cols-2 lg:grid-cols-3';
---
<div data-stagger class={`grid gap-5 ${colClass}`}>
  {items.map((item) => (
    <Card title={item.title} desc={item.desc} href={item.href} tag={item.tag} />
  ))}
</div>
