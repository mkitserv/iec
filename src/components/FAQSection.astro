---
interface Item { q: string; a: string }
interface Props {
  eyebrow?: string;
  title: string;
  intro?: string;
  num?: string;
  items: Item[];
}
const { eyebrow = 'FAQ', title, intro, num, items } = Astro.props;
---
<div class="grid lg:grid-cols-[0.82fr_1.18fr] gap-10 lg:gap-16 items-start">
  <div class="reveal lg:sticky lg:top-28">
    <div class="flex items-baseline gap-4">
      {num && <span class="section-num">{num}</span>}
      <p class="eyebrow">{eyebrow}</p>
    </div>
    <h2 class="mt-4 h-1 text-navy">{title}</h2>
    {intro && <p class="mt-5 text-navy-light leading-relaxed">{intro}</p>}

    <div class="mt-8 rounded-xl border border-gray-200 bg-white p-6">
      <p class="font-display font-semibold text-navy">Ihre Frage ist nicht dabei?</p>
      <p class="mt-1.5 text-sm text-navy-light">Wir beraten Sie persönlich zu Werkstoff, Oberfläche und Stückzahl.</p>
      <a href="/kontakt" class="btn btn-primary mt-5 !py-2.5 !px-5 text-sm">Persönliche Beratung<span aria-hidden="true">→</span></a>
    </div>
  </div>

  <div class="reveal divide-y divide-gray-200 rounded-xl border border-gray-200 bg-white">
    {items.map((item) => (
      <details class="group">
        <summary class="flex cursor-pointer items-center justify-between gap-4 px-6 py-5 list-none">
          <span class="font-display font-medium text-navy text-[1.05rem]">{item.q}</span>
          <span class="grid place-items-center h-7 w-7 shrink-0 rounded-full border border-gray-200 text-blue transition-transform duration-200 group-open:rotate-45">+</span>
        </summary>
        <div class="px-6 pb-6 -mt-1 text-navy-light leading-relaxed text-[0.95rem]">{item.a}</div>
      </details>
    ))}
  </div>
</div>
