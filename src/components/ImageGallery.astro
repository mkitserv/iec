---
interface Item { src: string; alt: string; caption?: string }
interface Props { items: Item[]; cols?: 2 | 3; dark?: boolean }
const { items, cols = 3, dark = false } = Astro.props;
const colClass = cols === 2 ? 'sm:grid-cols-2' : 'sm:grid-cols-2 lg:grid-cols-3';
const frame = dark ? 'border-white/10 bg-white/[0.04]' : 'border-gray-200 bg-white';
---
<div data-stagger class={`grid gap-4 ${colClass}`}>
  {items.map((i) => (
    <figure class={`reveal group relative overflow-hidden rounded-xl border ${frame}`}>
      <img
        src={i.src}
        alt={i.alt}
        loading="lazy"
        decoding="async"
        class="aspect-[3/2] w-full object-cover transition-transform duration-500 group-hover:scale-105"
      />
      {i.caption && (
        <figcaption class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-ink/90 via-ink/40 to-transparent px-4 pb-3 pt-10">
          <span class="font-mono text-[11px] uppercase tracking-wider text-white">{i.caption}</span>
        </figcaption>
      )}
    </figure>
  ))}
</div>
