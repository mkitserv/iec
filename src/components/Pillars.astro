---
// Moderne, editoriale „Säulen"-Sektion mit großen Indexzahlen statt flacher Karten.
interface Item { title: string; desc: string }
interface Props { items: Item[]; dark?: boolean }
const { items, dark = false } = Astro.props;
const numClass = dark
  ? 'text-white/10 group-hover:text-blue-bright/30'
  : 'text-gray-100 group-hover:text-blue/20';
---
<div data-stagger class="grid gap-10 sm:grid-cols-3 sm:gap-8 lg:gap-12">
  {items.map((it, i) => (
    <div class="reveal group relative">
      <div class={`font-display font-bold leading-none tracking-tight text-6xl md:text-7xl transition-colors ${numClass}`}>
        {String(i + 1).padStart(2, '0')}
      </div>
      <div class="mt-5 h-0.5 w-12 bg-blue"></div>
      <h3 class={`mt-6 h-2 ${dark ? 'text-white' : 'text-navy'}`}>{it.title}</h3>
      <p class={`mt-3 leading-relaxed ${dark ? 'text-white/65' : 'text-navy-light'}`}>{it.desc}</p>
    </div>
  ))}
</div>
