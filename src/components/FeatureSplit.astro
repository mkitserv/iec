---
interface Props {
  eyebrow?: string;
  title: string;
  body?: string;
  bullets?: string[];
  reverse?: boolean;
  imageLabel?: string;
  image?: { src: string; alt: string };
  cta?: { label: string; href: string };
}
const { eyebrow, title, body, bullets = [], reverse = false, imageLabel = 'Produktdetail', image, cta } = Astro.props;
---
<div class={`grid lg:grid-cols-2 gap-10 lg:gap-16 items-center`}>
  <div class={`reveal ${reverse ? 'lg:order-2' : ''}`}>
    {eyebrow && <p class="eyebrow mb-4">{eyebrow}</p>}
    <h2 class="hl-2 text-navy">{title}</h2>
    {body && <p class="mt-5 text-navy-light leading-relaxed">{body}</p>}
    {bullets.length > 0 && (
      <ul class="mt-6 space-y-3">
        {bullets.map((b) => (
          <li class="flex gap-3 text-sm text-navy-light">
            <span class="mt-1 grid place-items-center h-5 w-5 shrink-0 rounded-full bg-blue/10 text-blue text-xs font-bold">✓</span>
            <span>{b}</span>
          </li>
        ))}
      </ul>
    )}
    {cta && <a href={cta.href} class="btn btn-secondary mt-8 !py-2.5 !px-5 text-sm">{cta.label}<span aria-hidden="true">→</span></a>}
  </div>

  <div class={`reveal ${reverse ? 'lg:order-1' : ''}`}>
    {image ? (
      <figure class="overflow-hidden rounded-2xl border border-gray-200 shadow-[0_30px_70px_-35px_rgba(10,15,34,0.5)]">
        <img src={image.src} alt={image.alt} width="600" height="400" loading="lazy" decoding="async" class="w-full aspect-[3/2] object-cover" />
      </figure>
    ) : (
      <div class="relative aspect-[4/3] rounded-2xl border border-gray-200 bg-gradient-to-br from-gray-50 to-gray-200 overflow-hidden">
        <div class="absolute inset-0 blueprint opacity-[0.5] [filter:invert(1)]"></div>
        <span class="absolute left-4 top-4 h-4 w-4 border-l-2 border-t-2 border-blue/40"></span>
        <span class="absolute right-4 bottom-4 h-4 w-4 border-r-2 border-b-2 border-blue/40"></span>
        <div class="absolute inset-0 grid place-items-center text-muted text-sm font-mono">{imageLabel}</div>
      </div>
    )}
  </div>
</div>
