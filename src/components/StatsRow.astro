---
interface Stat { value: string; label: string; count?: { to: number; prefix?: string; suffix?: string } }
interface Props { stats: Stat[]; dark?: boolean }
const { stats, dark = false } = Astro.props;
---
<div class="reveal grid grid-cols-2 md:grid-cols-4 gap-8">
  {stats.map((s) => (
    <div class="text-center">
      <div class={`font-display text-4xl md:text-5xl font-bold tracking-tight ${dark ? 'text-white' : 'text-navy'}`}>
        {s.count
          ? <span data-counter data-target={s.count.to} data-prefix={s.count.prefix ?? ''} data-suffix={s.count.suffix ?? ''}>{(s.count.prefix ?? '') + '0' + (s.count.suffix ?? '')}</span>
          : s.value}
      </div>
      <div class={`mt-2 text-xs font-mono uppercase tracking-wider ${dark ? 'text-white/55' : 'text-muted'}`}>{s.label}</div>
    </div>
  ))}
</div>
