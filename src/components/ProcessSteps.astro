---
interface Step { title: string; desc: string }
interface Props { steps: Step[]; dark?: boolean }
const { steps, dark = false } = Astro.props;
---
<ol class="grid gap-px sm:grid-cols-2 lg:grid-cols-4 rounded-2xl overflow-hidden border border-gray-200 bg-gray-200">
  {steps.map((s, i) => (
    <li class={`reveal relative p-7 ${dark ? 'bg-ink/60 text-white/70' : 'bg-white'}`}>
      <span class="font-mono text-sm text-blue">{String(i + 1).padStart(2, '0')}</span>
      <h3 class={`mt-4 text-lg font-semibold ${dark ? 'text-white' : 'text-navy'}`}>{s.title}</h3>
      <p class={`mt-2 text-sm leading-relaxed ${dark ? 'text-white/60' : 'text-navy-light'}`}>{s.desc}</p>
    </li>
  ))}
</ol>
