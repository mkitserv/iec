---
import ValveDiagram from './ValveDiagram.astro';

interface Cta { label: string; href: string }
interface Crumb { name: string; href: string }
interface Stat { value: string; label: string; count?: { to: number; prefix?: string; suffix?: string } }
interface Props {
  eyebrow?: string;
  title: string;
  highlight?: string;          // Teilstring im Titel farblich hervorheben
  subtitle?: string;
  badges?: string[];
  primary?: Cta;
  secondary?: Cta;
  diagram?: boolean;           // Technikgrafik rechts
  image?: { src: string; alt: string; caption?: string }; // echtes Foto rechts (heller Spotlight)
  layout?: 'split' | 'centered';
  breadcrumbs?: Crumb[];
  stats?: Stat[];
}
const {
  eyebrow, title, highlight, subtitle, badges = [],
  primary, secondary, diagram = false, image, layout = 'split',
  breadcrumbs, stats = [],
} = Astro.props;

const parts = highlight && title.includes(highlight)
  ? [title.slice(0, title.indexOf(highlight)), highlight, title.slice(title.indexOf(highlight) + highlight.length)]
  : null;
const isSplit = layout === 'split' && (diagram || !!image);
---
<section class="relative overflow-hidden ink-gradient text-white">
  <div class="absolute inset-0 blueprint opacity-70"></div>
  <div class="glow-blue absolute -top-40 -left-20 opacity-80"></div>
  <div class="absolute inset-x-0 bottom-0 h-px bg-gradient-to-r from-transparent via-white/15 to-transparent"></div>

  <div class={`container-iec relative z-10 ${isSplit ? 'grid lg:grid-cols-[1.1fr_0.9fr] gap-12 lg:gap-8 items-center' : 'max-w-3xl mx-auto text-center'} pt-28 pb-20 md:pt-36 md:pb-28`}>
    <div class="reveal">
      {breadcrumbs && breadcrumbs.length > 0 && (
        <nav aria-label="Brotkrumen" class={`mb-6 text-xs text-white/55 font-mono ${isSplit ? '' : 'justify-center'} flex gap-2`}>
          {breadcrumbs.map((c, i) => (
            <span class="inline-flex items-center gap-2">
              {i > 0 && <span class="text-white/30">/</span>}
              {i < breadcrumbs.length - 1 ? <a href={c.href} class="hover:text-white">{c.name}</a> : <span class="text-white/80">{c.name}</span>}
            </span>
          ))}
        </nav>
      )}

      {eyebrow && <p class={`eyebrow eyebrow-light mb-5 ${isSplit ? '' : 'justify-center'}`}>{eyebrow}</p>}

      <h1 class="hl-display text-white">
        {parts ? (<>{parts[0]}<span class="text-blue-bright">{parts[1]}</span>{parts[2]}</>) : title}
      </h1>

      {subtitle && <p class={`mt-6 text-lg leading-relaxed text-white/70 ${isSplit ? 'max-w-xl' : 'max-w-2xl mx-auto'}`}>{subtitle}</p>}

      {badges.length > 0 && (
        <div class={`flex flex-wrap gap-2 mt-7 ${isSplit ? '' : 'justify-center'}`}>
          {badges.map((b) => <span class="pill pill-dark">{b}</span>)}
        </div>
      )}

      {(primary || secondary) && (
        <div class={`flex flex-wrap gap-3 mt-9 ${isSplit ? '' : 'justify-center'}`}>
          {primary && <a href={primary.href} class="btn btn-on-dark">{primary.label}<span aria-hidden="true">→</span></a>}
          {secondary && <a href={secondary.href} class="btn btn-ghost-light">{secondary.label}</a>}
        </div>
      )}
    </div>

    {isSplit && (
      <div class="reveal relative">
        {image ? (
          <figure class="rounded-2xl bg-white p-5 shadow-[0_40px_90px_-35px_rgba(0,0,0,0.75)] ring-1 ring-white/10">
            <img src={image.src} alt={image.alt} width="1500" height="623" loading="eager" fetchpriority="high" decoding="async" class="w-full h-auto rounded-lg" />
            {image.caption && <figcaption class="mt-3 text-center font-mono text-[11px] uppercase tracking-[0.18em] text-navy-light">{image.caption}</figcaption>}
          </figure>
        ) : (
          <div class="relative rounded-2xl border border-white/10 bg-white/[0.03] p-4 backdrop-blur-sm">
            <span class="absolute left-3 top-3 h-3 w-3 border-l border-t border-white/30"></span>
            <span class="absolute right-3 top-3 h-3 w-3 border-r border-t border-white/30"></span>
            <span class="absolute left-3 bottom-3 h-3 w-3 border-l border-b border-white/30"></span>
            <span class="absolute right-3 bottom-3 h-3 w-3 border-r border-b border-white/30"></span>
            <ValveDiagram class="w-full h-auto" />
          </div>
        )}
      </div>
    )}
  </div>

  {stats.length > 0 && (
    <div class="container-iec relative z-10 pb-16 md:pb-20">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-px rounded-2xl overflow-hidden border border-white/10 bg-white/[0.06]">
        {stats.map((s) => (
          <div class="bg-ink/40 px-6 py-7 text-center md:text-left">
            <div class="font-display text-3xl md:text-4xl font-bold text-white">
              {s.count
                ? <span data-counter data-target={s.count.to} data-prefix={s.count.prefix ?? ''} data-suffix={s.count.suffix ?? ''}>{(s.count.prefix ?? '') + '0' + (s.count.suffix ?? '')}</span>
                : s.value}
            </div>
            <div class="mt-1.5 text-xs text-white/55 font-mono uppercase tracking-wider">{s.label}</div>
          </div>
        ))}
      </div>
    </div>
  )}
</section>
