---
interface Props { items: string[] }
const { items } = Astro.props;
---
<div class="bg-cream border-b border-gray-200">
  <div class="container-iec flex flex-wrap justify-center md:justify-between gap-x-8 gap-y-3 py-5 text-sm text-navy-light">
    {items.map((item) => (
      <span class="inline-flex items-center gap-2 font-medium">
        <span class="text-blue">✓</span>{item}
      </span>
    ))}
  </div>
</div>
