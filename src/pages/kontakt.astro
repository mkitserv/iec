---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import Section from '../components/Section.astro';
import SectionHeading from '../components/SectionHeading.astro';
import ProcessSteps from '../components/ProcessSteps.astro';
import { company } from '../lib/site';

const breadcrumbs = [
  { name: 'Start', href: '/' },
  { name: 'Kontakt', href: '/kontakt' },
];
const telHref = 'tel:' + company.phone.replace(/[^+\d]/g, '');
---
<Layout
  title="Kontakt & Anfrage an IEC Germany | Motorenkomponenten"
  description="Sprechen Sie direkt mit dem Hersteller: Anfrage, Zeichnung oder Muster an IEC senden. Persönliche Beratung zu Ventilen und Motorenteilen, ab 1 Stück."
  schemaType="ContactPage"
  breadcrumbs={breadcrumbs}
>
  <Hero
    layout="centered"
    eyebrow="Kontakt"
    title="Sprechen Sie mit dem Hersteller"
    highlight="dem Hersteller"
    subtitle="Senden Sie uns Ihre Anfrage, eine technische Zeichnung oder ein Muster. Sie erhalten eine persönliche Antwort direkt von den Fachleuten, die Ihre Teile fertigen – ohne Umwege über einen Zwischenhandel."
    breadcrumbs={breadcrumbs}
  />

  <Section bg="white">
    <p class="reveal text-navy-light leading-relaxed max-w-3xl">
      Als Hersteller mit Sitz in Kirchberg an der Murr begleiten wir Ihr Projekt von der ersten technischen
      Rückfrage bis zur dokumentierten Auslieferung. Ob Serienbedarf an
      <a href="/ventile" class="text-blue hover:underline">Ventilen</a>, Ersatzteile für
      <a href="/biogasanlagen" class="text-blue hover:underline">Biogasanlagen</a> oder spezielle
      <a href="/motorenteile" class="text-blue hover:underline">Motorenteile</a> nach Zeichnung – wir beraten Sie
      persönlich zu Werkstoff, Oberfläche, Toleranzen und Stückzahl. Nutzen Sie das Formular oder erreichen Sie uns
      direkt per Telefon und E-Mail.
    </p>

    <div class="mt-12 grid lg:grid-cols-2 gap-12 items-start">
      <div class="reveal">
        <div class="space-y-8">
          <div>
            <p class="eyebrow mb-2">Anschrift</p>
            <address class="not-italic text-navy leading-relaxed">
              {company.name}<br />
              {company.street}<br />
              {company.zip} {company.city}<br />
              {company.country}
            </address>
          </div>

          <div>
            <p class="eyebrow mb-2">Telefon</p>
            <a href={telHref} class="text-navy hover:text-blue">{company.phone}</a>
          </div>

          <div>
            <p class="eyebrow mb-2">Fax</p>
            <p class="text-navy">{company.fax}</p>
          </div>

          <div>
            <p class="eyebrow mb-2">E-Mail</p>
            <a href={`mailto:${company.email}`} class="text-navy hover:text-blue">{company.email}</a>
          </div>

          <div>
            <p class="eyebrow mb-2">Geschäftsführer</p>
            <p class="text-navy">{company.ceo}</p>
          </div>
        </div>

        <p class="reveal text-navy-light leading-relaxed max-w-3xl mt-10">
          Unser Team kennt die Anforderungen anspruchsvoller Antriebe aus jahrzehntelanger Praxis. Schildern Sie uns
          Ihren Anwendungsfall – vom Gasmotor über den Industriemotor bis zum historischen Aggregat – und wir
          empfehlen Ihnen die passende Lösung. Eine kurze Beschreibung, eine Zeichnung oder ein Altteil als Muster
          genügen als Grundlage für ein belastbares Angebot.
        </p>
      </div>

      <div class="reveal">
        <div class="rounded-xl border border-gray-200 p-6 md:p-8 bg-white">
          <form action="#" method="post" class="space-y-4">
            <div>
              <label for="name" class="block text-sm font-medium text-navy mb-1.5">Name</label>
              <input type="text" id="name" name="name" autocomplete="name" class="w-full rounded-md border border-gray-200 px-4 py-3 text-sm focus:border-blue outline-none" />
            </div>
            <div>
              <label for="firma" class="block text-sm font-medium text-navy mb-1.5">Firma</label>
              <input type="text" id="firma" name="firma" autocomplete="organization" class="w-full rounded-md border border-gray-200 px-4 py-3 text-sm focus:border-blue outline-none" />
            </div>
            <div>
              <label for="email" class="block text-sm font-medium text-navy mb-1.5">E-Mail</label>
              <input type="email" id="email" name="email" autocomplete="email" class="w-full rounded-md border border-gray-200 px-4 py-3 text-sm focus:border-blue outline-none" />
            </div>
            <div>
              <label for="telefon" class="block text-sm font-medium text-navy mb-1.5">Telefon</label>
              <input type="tel" id="telefon" name="telefon" autocomplete="tel" class="w-full rounded-md border border-gray-200 px-4 py-3 text-sm focus:border-blue outline-none" />
            </div>
            <div>
              <label for="nachricht" class="block text-sm font-medium text-navy mb-1.5">Nachricht</label>
              <textarea id="nachricht" name="nachricht" rows="5" class="w-full rounded-md border border-gray-200 px-4 py-3 text-sm focus:border-blue outline-none"></textarea>
            </div>
            <button type="submit" class="btn btn-primary w-full">Anfrage senden →</button>
            <p class="text-xs text-muted mt-3">Unverbindlich · Wir antworten in der Regel binnen 24 Stunden.</p>
          </form>
        </div>
      </div>
    </div>
  </Section>

  <Section bg="cream">
    <SectionHeading
      num="01"
      eyebrow="Ablauf"
      title="So läuft Ihre Anfrage"
      intro="Von der ersten Kontaktaufnahme bis zur Lieferung begleiten wir Sie in vier nachvollziehbaren Schritten – persönlich, transparent und direkt vom Hersteller."
    />
    <p class="reveal text-navy-light leading-relaxed max-w-3xl mb-10">
      Wir legen Wert auf klare Kommunikation und kurze Wege. Nach Ihrer Anfrage prüfen wir gemeinsam mit Ihnen die
      technischen Details, stimmen Werkstoff und Fertigungsverfahren ab und unterbreiten Ihnen ein konkretes Angebot –
      bereits ab einem einzelnen Stück. Die anschließende Fertigung erfolgt in Deutschland, geprüft und dokumentiert,
      sodass Sie sich auf gleichbleibende Qualität verlassen können.
    </p>
    <ProcessSteps steps={[
      { title: 'Anfrage senden', desc: 'Mit Zeichnung, Muster oder Beschreibung.' },
      { title: 'Persönliche Beratung', desc: 'Wir klären Werkstoff, Oberfläche, Menge.' },
      { title: 'Angebot', desc: 'Konkretes Angebot, ab 1 Stück.' },
      { title: 'Fertigung & Lieferung', desc: 'Geprüft und dokumentiert, Made in Germany.' },
    ]} />
  </Section>
</Layout>
